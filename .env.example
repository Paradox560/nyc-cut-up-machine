# Copy to .env.local. Keep all credentials out of Git.
MISTRAL_API_KEY=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=nyc-cut-up-machine
MISTRAL_CHAT_MODEL=mistral-large-4
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_EMBED_MODEL=mistral-embed
# Optional: enable Mistral speech with a voice from Mistral Studio.
MISTRAL_VOICE_ID=
MISTRAL_TTS_MODEL=voxtral-mini-tts-latest
